{
  "name": "@mint-engine/server",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b && node dist/main.js",
    "start": "node dist/main.js",
    "test": "vitest run --root ../.. apps/server/test",
    "e2e": "tsc -b && vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@mint-engine/core": "0.1.0",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2"
  }
}
