{
  "name": "@mint-engine/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:core": "tsc -b ../../packages/core",
    "dev": "npm run build:core && vite --host 127.0.0.1",
    "dev:mock": "npm run build:core && vite --mode mock --host 127.0.0.1 --port 22245 --strictPort",
    "build": "npm run build:core && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@mint-engine/core": "0.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "ws": "^8.18.0"
  }
}
